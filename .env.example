# Ключи Bybit для локальной работы (`bun run dev`).
# Скопируй в .env и впиши значения:  cp .env.example .env
# Файл .env в .gitignore — секреты никогда не попадают в репозиторий.
# Подхват делает только dev-сервер (vite.config.ts, devBybitKeys); в сборку (bun run build)
# значения не инжектятся, поэтому в dist/ их нет.

# Ключ и секрет Bybit V5. Для реальных денег — ключ без права вывода + IP-allowlist.
API_KEY=
API_SECRET=

# 1 = тестнет (api-testnet.bybit.com), пусто/0 = мейннет (реальные деньги).
API_TESTNET=
